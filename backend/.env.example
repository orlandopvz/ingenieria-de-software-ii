PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emprendebuho
DB_POOL_MAX=5
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emprendebuho_test
# Vercel Services: deja VITE_API_BASE_URL sin definir para usar /api.
# En Vercel configura DATABASE_URL, JWT_SECRET y REPORT_IP_SALT con valores propios.
# VERCEL_URL y VERCEL_PROJECT_PRODUCTION_URL se reciben de la plataforma.
UPLOAD_DIR=./uploads
STORAGE_DIR=./storage
BACKUP_DIR=./database/backups
BACKUP_KEEP=10
ALLOWED_EMAIL_DOMAINS=unison.mx
INACTIVITY_DAYS_LIMIT=30
MAINTENANCE_INTERVAL_HOURS=12
REPORT_IP_SALT=cambia_esto_tambien
