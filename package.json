{
  "name": "emprendebuho",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,yellow \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "test": "npm test -w backend && npm test -w frontend",
    "test:e2e": "npm run test:e2e -w frontend",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "db:reset": "npm run db:reset -w backend --",
    "db:init": "npm run db:init -w backend --",
    "db:seed": "npm run db:seed -w backend --",
    "db:migrate:sqlite": "npm run db:migrate:sqlite -w backend --",
    "verify:neon": "node scripts/verifyNeon.mjs"
  },
  "devDependencies": {
    "@neon/config": "^1.14.1",
    "@neon/env": "^2.1.4",
    "concurrently": "^9.0.0"
  }
}
